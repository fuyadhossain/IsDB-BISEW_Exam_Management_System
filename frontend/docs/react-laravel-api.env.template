# Copy these values into .env.local when you are ready to connect Laravel.
# Do not add database passwords, API keys, or other secrets here: VITE_ values
# are included in the browser build and therefore are public.

# Laravel API base URL, including the /api prefix.
VITE_API_BASE_URL=http://localhost:8000/api

# Keep true while Laravel endpoints are unavailable. Set false after the API
# endpoints, authentication, CORS, and authorization are configured.
VITE_USE_MOCK_API=true

# Application display time zone. Laravel must store timestamps in UTC and
# enforce all examination timing with the server clock.
VITE_APP_TIME_ZONE=Asia/Dhaka
